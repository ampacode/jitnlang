using <physics>
using <neuro>
using <quantum>

print(PV(10, 2, 3))        # 16
print(PS(10, 2, 3))        # 39
print(PKin(2, 3))          # 9
print(POrbitV(5.972e24, 6371000) > 7000)
print(PPendulum(1))
