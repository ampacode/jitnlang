    i += 1
print("while=" + str(i))

int sum = 0
for (i = 1; i <= 10; i += 1)
    sum += i
print("sum=" + str(sum))

list<int> nums = [10, 20, 30]
print(nums[0])
print(nums.size())

for (v : nums)
    print(v)

for (k, v : nums)
    print(str(k) + "->" + str(v))

nums.append(40)
print(nums[3])

json d = {"a": 1, "b": 2}
print(d["a"])
d["c"] = 3
print(d["c"])

for (k, v : d)
    print(k + "=" + str(v))

int fib(int n)
    if (n < 2)
        return n
    return fib(n - 1) + fib(n - 2)

print("fib(20)=" + str(fib(20)))

sq = (a)
    return a * a
print(sq(7))

int total = 0
for (i = 1; i <= 100; i += 1)
    if (i > 5)
        break
    total += i
print("total=" + str(total))

