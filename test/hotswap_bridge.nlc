# hot-swap функция зовёт другую интерпретируемую функцию —
# должно работать через обратный мост dll -> eval
using <time>

int helper(int x)
    return x * 100

int caller(int n)
    return helper(n) + 1

int i = 0
while (i < 100)
    caller(i)
    i += 1

# даём фоновой компиляции время
int t = 0
while (t < 6)
    time.sleep(500)
    t += 1

print(caller(7))
