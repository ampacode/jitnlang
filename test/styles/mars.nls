css mars {

    int gap = 16;
    int rad = 14;

    gabab {
        margin = 0 px;
        background = 0x030309;
        color = m1;
        font-family = "Consolas", monospace;
        overflow = hidden;
    }

    .space {
        min-height = 100 vh;
        display = flex;
        flex-direction = column;
        align-items = center;
        justify-content = center;
        gap = gap px;
    }

    .title {
        margin = 0 px;
        color = 0xff5a33;
        font-weight = 100;
        font-size = 46 px;
        letter-spacing = 20 px;
        text-transform = uppercase;
        text-shadow = 0 0 26 px 0xff5a33;
    }

    .sub {
        color = m2;
        font-size = 11 px;
        letter-spacing = 6 px;
        text-transform = uppercase;
        margin = -10 px 0 6 px;
    }

    (sky) {
        display = block;
        background = 0x020206;
        border = 1 px solid 0x2a120a;
        border-radius = rad px;
        box-shadow = 0 0 80 px 0x200800, inset 0 0 2 px 0xff5a33;
    }

    .deck {
        display = flex;
        align-items = center;
        gap = gap px;
        padding = 10 px 22 px;
        min-width = 520 px;
        background = gabaa;
        border = 1 px solid 0x2a1a12;
        border-radius = rad px;
    }

    .btn {
        background = 0xff5a33;
        color = 0x0a0503;
        border = none;
        padding = 10 px 28 px;
        font-family = "Consolas", monospace;
        font-size = 13 px;
        letter-spacing = 5 px;
        border-radius = rad px;
        cursor = pointer;
        transition = opacity 200 ms ease;

        &:hover {
            opacity = 80 %;
        }
    }

    (vol) {
        accent-color = 0xff5a33;
        width = 190 px;
    }

    .status {
        color = m2;
        font-size = 12 px;
        letter-spacing = 2 px;
        text-transform = uppercase;
    }

    .track {
        margin-left = auto;
        color = 0xff5a33;
        font-size = 11 px;
        letter-spacing = 3 px;
        text-transform = uppercase;
        opacity = 60 %;
    }
}
